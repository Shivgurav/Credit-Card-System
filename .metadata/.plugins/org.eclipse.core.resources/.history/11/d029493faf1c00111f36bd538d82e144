package com.payPanda.service;

import java.time.LocalDateTime;
import java.util.Optional;
import java.util.Random;

import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import com.payPanda.dto.CardDeatilsDTO;
import com.payPanda.dto.MerchantDetailsDTO;
import com.payPanda.dto.TransactionRequestDTO;
import com.payPanda.entity.TransactionEntity;
import com.payPanda.repository.TransactionRepository;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class TransactionServiceImple implements TransactionService {
	private final TransactionRepository repo;
	private static final RestTemplate restTemplate = new RestTemplate();
	
	@Override
	public String createTransaction(TransactionRequestDTO transactionRequestDTO) {
		Long cardNumber =transactionRequestDTO.getCardNumber();
		String merchantId=transactionRequestDTO.getMerchantId();
		
		CardDeatilsDTO validated=validateCardNumer(cardNumber);
		Boolean validateMerchant=validateMerchantId(merchantId);
		Boolean validateCardNumber=validated.getValid();
		 TransactionEntity transaction = new TransactionEntity();
		 if(validateMerchant && validateCardNumber) {

		    transaction.setCardNumber(transactionRequestDTO.getCardNumber());
		    transaction.setMerchantId(transactionRequestDTO.getMerchantId());
		    transaction.setAmount(transactionRequestDTO.getAmount());

		    transaction.setTransactionDate(LocalDateTime.now());

		    transaction.setAuthCode(generateAuthCode());
		    transaction.setStatus("APPROVED");
   repo.save(transaction);
		    
		
		return validated.getMessage();
		 }
		 else {
			 return "INVALID DETAILS";
		 }
		
	}
	private String generateAuthCode() {
	    Random random = new Random();
	    int code = 100000 + random.nextInt(900000);
	    return String.valueOf(code);
	}
	
	

		private  Boolean validateMerchantId(String merchantId) {
		// TODO Auto-generated method stub
			String url = "http://192.168.0.157:8084/cards/validate/" + merchantId;
			MerchantDetailsDTO merchantDetailsDTO= restTemplate.getForObject(url,MerchantDetailsDTO.class);
			
		 boolean valid=merchantDetailsDTO.getValid();
		 return valid;
	}
		
		
		
		
		private CardDeatilsDTO validateCardNumer(Long cardNumber) {
			// TODO Auto-generated method stub
			String url = "http://192.168.0.157:8084/cards/validate/" + cardNumber;
			 CardDeatilsDTO card =
	                    restTemplate.getForObject(url, CardDeatilsDTO.class);
			 return card;
			
			
		}

}
