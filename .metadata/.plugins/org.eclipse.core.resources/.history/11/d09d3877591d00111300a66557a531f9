package com.payPanda.entity;

import jakarta.persistence.*;
import lombok.Data;

import java.math.BigDecimal;

/**
 * Represents an issued credit card.
 * Created automatically when admin approves a CardApplication.
 * Maps to the credit_card table in Neon DB (doc section 7.2).
 */
@Entity
@Table(name = "credit_card")
@Data
public class CreditCardEntity {

    @Id
    @Column(name = "card_number")
    private Long cardNumber;            // 16-digit, starts with 4 (VISA) or 5 (MASTERCARD)

    @Column(name = "customer_id")
    private Long customerId;            // references customer table (via customer-service)

    @Column(name = "application_id")
    private Long applicationId;         // back-reference to the application

    @Column(name = "card_type", length = 20, nullable = false)
    private String cardType;            // "VISA" or "MASTERCARD"

    @Column(name = "cvv", length = 3, nullable = false)
    private String cvv;                 // 3-digit CVV (stored hashed in production)

    @Column(name = "credit_limit", nullable = false, precision = 10, scale = 2)
    private BigDecimal creditLimit;     // Assigned based on salary from product master

    @Column(name = "available_limit", nullable = false, precision = 10, scale = 2)
    private BigDecimal availableLimit;  // Starts equal to credit_limit

    @Column(name = "per_day_limit", nullable = false, precision = 10, scale = 2)
    private BigDecimal perDayLimit;     // Daily spend cap from product master

    @Column(name = "expiry_date", length = 5, nullable = false)
    private String expiryDate;          // Format: YYMM  e.g. "2812" = Dec 2028

    @Column(name = "card_status", length = 20, nullable = false)
    private String cardStatus;          // "Open" | "Blocked" | "Closed"

    @Column(name = "name_on_card", length = 100, nullable = false)
    private String nameOnCard;
}