package com.payPanda.service;

import com.payPanda.dto.MerchantRequestDTO;
import com.payPanda.dto.MerchantResponseDTO;
import com.payPanda.dto.MerchantValidateDTO;
import com.payPanda.entity.MerchantEntity;
import com.payPanda.exception.MerchantAlreadyExistsException;
import com.payPanda.exception.MerchantNotFoundException;
import com.payPanda.repository.MerchantRepository;

import lombok.RequiredArgsConstructor;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.Random;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
public class MerchantServiceImpl implements MerchantService {

    private static final Logger log = LoggerFactory.getLogger(MerchantServiceImpl.class);
    private final MerchantRepository merchantRepository;

    @Override
    public MerchantResponseDTO registerMerchant(MerchantRequestDTO request) {

        // Mandatory field duplicate checks (email and mobile per doc section 11.3)
        if (merchantRepository.existsByEmail(request.getEmail())) {
            throw new MerchantAlreadyExistsException("A merchant with this email already exists");
        }
        if (merchantRepository.existsByMobileNumber(request.getMobileNumber())) {
            throw new MerchantAlreadyExistsException("A merchant with this mobile number already exists");
        }

        MerchantEntity merchant = new MerchantEntity();
        merchant.setMerchantId(generateUniqueMerchantId());
        merchant.setMerchantName(request.getMerchantName());
        merchant.setEmail(request.getEmail());
        merchant.setMobileNumber(request.getMobileNumber());
        merchant.setBankName(request.getBankName());
        merchant.setAccountNumber(request.getAccountNumber());
        merchant.setIfscCode(request.getIfscCode());
        merchant.setStatus("Active");   // New merchants are Active by default

        MerchantEntity saved = merchantRepository.save(merchant);
        log.info("Merchant registered: id={} name={}", saved.getMerchantId(), saved.getMerchantName());

        return toDTO(saved);
    }

    @Override
    public MerchantResponseDTO getMerchantById(String merchantId) {
        MerchantEntity merchant = merchantRepository.findById(merchantId)
                .orElseThrow(() -> new MerchantNotFoundException("Merchant not found with id: " + merchantId));
        return toDTO(merchant);
    }

    @Override
    public List<MerchantResponseDTO> getAllMerchants() {
        return merchantRepository.findAll()
                .stream()
                .map(this::toDTO)
                .collect(Collectors.toList());
    }

    // ─────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────

    /**
     * Generates a unique 7-digit merchant ID (e.g. "1048576").
     * Retries up to 10 times in case of collision (extremely unlikely with 9M possible values).
     */
    private String generateUniqueMerchantId() {
        Random random = new Random();
        for (int attempt = 0; attempt < 10; attempt++) {
            // Range: 1000000–9999999 (always 7 digits)
            String id = String.valueOf(1000000 + random.nextInt(9000000));
            if (!merchantRepository.existsById(id)) {
                return id;
            }
        }
        throw new RuntimeException("Could not generate unique merchant ID after 10 attempts");
    }

    private MerchantResponseDTO toDTO(MerchantEntity entity) {
        MerchantResponseDTO dto = new MerchantResponseDTO();
        dto.setMerchantId(entity.getMerchantId());
        dto.setMerchantName(entity.getMerchantName());
        dto.setEmail(entity.getEmail());
        dto.setMobileNumber(entity.getMobileNumber());
        dto.setBankName(entity.getBankName());
        dto.setAccountNumber(entity.getAccountNumber());
        dto.setIfscCode(entity.getIfscCode());
        dto.setStatus(entity.getStatus());
        return dto;
    }

	@Override
	public MerchantValidateDTO validateMerchant(String merchantId) {
		// TODO Auto-generated method stub
		MerchantValidateDTO merchantValidateDTO=new MerchantValidateDTO();
		if(merchantRepository.existsByMerchantId(merchantId)) {
			merchantValidateDTO.setStatus("Active");
			merchantValidateDTO.setMerchantId(merchantId);
			return merchantValidateDTO;
			
		}
	}
}