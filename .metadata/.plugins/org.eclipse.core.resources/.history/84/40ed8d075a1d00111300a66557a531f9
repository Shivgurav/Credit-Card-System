package com.payPanda.service;

import com.payPanda.dto.*;
import com.payPanda.entity.CardApplicationEntity;
import com.payPanda.entity.CreditCardEntity;
import com.payPanda.exception.ApplicationNotFoundException;
import com.payPanda.exception.CardNotFoundException;
import com.payPanda.repository.CardApplicationRepository;
import com.payPanda.repository.CreditCardRepository;

import lombok.RequiredArgsConstructor;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.security.SecureRandom;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.List;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
public class CardServiceImpl implements CardService {

    private static final Logger log = LoggerFactory.getLogger(CardServiceImpl.class);
    private static final SecureRandom random = new SecureRandom();

    private final CardApplicationRepository applicationRepository;
    private final CreditCardRepository creditCardRepository;

    // ─────────────────────────────────────────────────────────────────────────
    // STEP 1 — Customer submits application
    // POST /cards/apply
    // ─────────────────────────────────────────────────────────────────────────

    @Override
    public CardApplicationResponseDTO submitApplication(CardApplicationRequestDTO request) {

        // One active application per PAN at a time
        if (applicationRepository.existsByPanNumber(request.getPanNumber())) {
            throw new IllegalStateException(
                    "An application with PAN " + request.getPanNumber() + " already exists.");
        }

        CardApplicationEntity application = new CardApplicationEntity();
        application.setName(request.getName());
        application.setDateOfBirth(request.getDateOfBirth());
        application.setEmail(request.getEmail());
        application.setMobileNumber(request.getMobileNumber());
        application.setAddress(request.getAddress());
        application.setPanNumber(request.getPanNumber().toUpperCase());
        application.setOccupation(request.getOccupation());
        application.setAnnualSalary(request.getAnnualSalary());
        application.setItReturnFiled(request.getItReturnFiled());
        application.setProductType(request.getProductType().toUpperCase());
        application.setStatus("PENDING");
        application.setAppliedAt(LocalDateTime.now());

        CardApplicationEntity saved = applicationRepository.save(application);
        log.info("Card application submitted: applicationId={} PAN={}", saved.getApplicationId(), saved.getPanNumber());

        return toApplicationDTO(saved);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // STEP 2 — Admin fetches pending applications
    // GET /cards/applications/pending
    // ─────────────────────────────────────────────────────────────────────────

    @Override
    public List<CardApplicationResponseDTO> getPendingApplications() {
        return applicationRepository.findByStatus("PENDING")
                .stream().map(this::toApplicationDTO).collect(Collectors.toList());
    }

    @Override
    public List<CardApplicationResponseDTO> getAllApplications() {
        return applicationRepository.findAll()
                .stream().map(this::toApplicationDTO).collect(Collectors.toList());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // STEP 3 — Admin approves or rejects
    // PUT /cards/applications/{applicationId}/review
    // On APPROVED → card is auto-issued immediately
    // ─────────────────────────────────────────────────────────────────────────

    @Override
    @Transactional
    public CardApplicationResponseDTO reviewApplication(Long applicationId, ApplicationReviewDTO review) {

        CardApplicationEntity application = applicationRepository.findById(applicationId)
                .orElseThrow(() -> new ApplicationNotFoundException(
                        "Application not found with id: " + applicationId));

        if (!"PENDING".equals(application.getStatus())) {
            throw new IllegalStateException(
                    "Application " + applicationId + " has already been " + application.getStatus());
        }

        application.setReviewedAt(LocalDateTime.now());

        if ("APPROVED".equals(review.getDecision())) {
            application.setStatus("APPROVED");

            // ── Auto-issue the card ───────────────────────────────────────────
            CreditCardEntity card = issueCard(application);
            application.setIssuedCardNumber(card.getCardNumber());

            log.info("Application {} APPROVED — card {} issued", applicationId, card.getCardNumber());

        } else {
            if (review.getRejectionReason() == null || review.getRejectionReason().isBlank()) {
                throw new IllegalStateException("Rejection reason is required when rejecting an application");
            }
            application.setStatus("REJECTED");
            application.setRejectionReason(review.getRejectionReason());

            log.info("Application {} REJECTED — reason: {}", applicationId, review.getRejectionReason());
        }

        return toApplicationDTO(applicationRepository.save(application));
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Card lookup and management
    // ─────────────────────────────────────────────────────────────────────────

    @Override
    public CreditCardResponseDTO getCardByNumber(Long cardNumber) {
        CreditCardEntity card = creditCardRepository.findById(cardNumber)
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + cardNumber));
        return toCardDTO(card);
    }

    @Override
    public List<CreditCardResponseDTO> getCardsByCustomer(Long customerId) {
        return creditCardRepository.findByCustomerId(customerId)
                .stream().map(this::toCardDTO).collect(Collectors.toList());
    }

    @Override
    @Transactional
    public CreditCardResponseDTO updateCardStatus(CardStatusUpdateDTO request) {
        CreditCardEntity card = creditCardRepository.findById(request.getCardNumber())
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + request.getCardNumber()));

        String oldStatus = card.getCardStatus();
        card.setCardStatus(request.getStatus());
        creditCardRepository.save(card);

        log.info("Card {} status changed: {} → {}", request.getCardNumber(), oldStatus, request.getStatus());
        return toCardDTO(card);
    }

    // ── Called by transaction-service after an approved transaction ───────────
    @Override
    @Transactional
    public void deductAvailableLimit(Long cardNumber, BigDecimal amount) {
        CreditCardEntity card = creditCardRepository.findById(cardNumber)
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + cardNumber));

        BigDecimal newLimit = card.getAvailableLimit().subtract(amount);
        if (newLimit.compareTo(BigDecimal.ZERO) < 0) {
            throw new IllegalStateException("Deduction would result in negative available limit");
        }

        card.setAvailableLimit(newLimit);
        creditCardRepository.save(card);
        log.info("Limit deducted for card={} amount={} newAvailableLimit={}", cardNumber, amount, newLimit);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Private — Card issuance logic
    // ─────────────────────────────────────────────────────────────────────────

    /**
     * Automatically issues a credit card when an application is approved.
     *
     * Card number rules (doc section 11.1):
     *   - 16 digits total
     *   - VISA starts with 4
     *   - MASTERCARD starts with 5
     *
     * Credit limit rules (salary-based):
     *   - < 3 LPA          → ₹50,000
     *   - 3–6 LPA          → ₹1,00,000
     *   - 6–12 LPA         → ₹2,50,000
     *   - > 12 LPA         → ₹5,00,000
     *
     * Per-day limit = 20% of credit limit
     * Expiry = 3 years from today in YYMM format
     */
    private CreditCardEntity issueCard(CardApplicationEntity application) {

        CreditCardEntity card = new CreditCardEntity();

        // Generate unique 16-digit card number
        card.setCardNumber(generateUniqueCardNumber(application.getProductType()));

        // Card type from product preference
        card.setCardType(application.getProductType());

        // Name on card
        card.setNameOnCard(application.getName().toUpperCase());

        // CVV — 3 random digits
        card.setCvv(generateCvv());

        // Credit limit based on annual salary
        BigDecimal creditLimit = calculateCreditLimit(application.getAnnualSalary());
        card.setCreditLimit(creditLimit);
        card.setAvailableLimit(creditLimit);   // starts full
        card.setPerDayLimit(creditLimit.multiply(new BigDecimal("0.20")));  // 20% of credit limit

        // Expiry: 3 years from today, format YYMM  e.g. "2812"
        LocalDate expiry = LocalDate.now().plusYears(3);
        card.setExpiryDate(expiry.format(DateTimeFormatter.ofPattern("yyMM")));

        // Status — new cards start as Open
        card.setCardStatus("Open");

        // Back-reference
        card.setApplicationId(application.getApplicationId());

        CreditCardEntity saved = creditCardRepository.save(card);
        log.info("Card issued: cardNumber={} type={} limit={} expiry={}",
                saved.getCardNumber(), saved.getCardType(),
                saved.getCreditLimit(), saved.getExpiryDate());

        return saved;
    }

    /**
     * Salary-based credit limit assignment.
     * Annual salary expected in INR (rupees, not lakhs).
     */
    private BigDecimal calculateCreditLimit(BigDecimal annualSalary) {
        double salary = annualSalary.doubleValue();

        if (salary < 300_000) {
            return new BigDecimal("50000");
        } else if (salary < 600_000) {
            return new BigDecimal("100000");
        } else if (salary < 1_200_000) {
            return new BigDecimal("250000");
        } else {
            return new BigDecimal("500000");
        }
    }

    /**
     * Generates a unique 16-digit card number.
     * VISA: starts with 4  |  MASTERCARD: starts with 5  (doc section 11.1)
     * Retries up to 10 times to avoid collisions.
     */
    private Long generateUniqueCardNumber(String productType) {
        String prefix = "VISA".equals(productType) ? "4" : "5";

        for (int attempt = 0; attempt < 10; attempt++) {
            // Generate 15 remaining digits
            StringBuilder sb = new StringBuilder(prefix);
            for (int i = 0; i < 15; i++) {
                sb.append(random.nextInt(10));
            }
            Long cardNumber = Long.parseLong(sb.toString());
            if (!creditCardRepository.existsById(cardNumber)) {
                return cardNumber;
            }
        }
        throw new RuntimeException("Could not generate unique card number after 10 attempts");
    }

    /**
     * Generates a 3-digit CVV string.
     */
    private String generateCvv() {
        return String.format("%03d", random.nextInt(1000));
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Mappers
    // ─────────────────────────────────────────────────────────────────────────

    private CardApplicationResponseDTO toApplicationDTO(CardApplicationEntity e) {
        CardApplicationResponseDTO dto = new CardApplicationResponseDTO();
        dto.setApplicationId(e.getApplicationId());
        dto.setName(e.getName());
        dto.setEmail(e.getEmail());
        dto.setMobileNumber(e.getMobileNumber());
        dto.setPanNumber(e.getPanNumber());
        dto.setDateOfBirth(e.getDateOfBirth());
        dto.setOccupation(e.getOccupation());
        dto.setAnnualSalary(e.getAnnualSalary());
        dto.setItReturnFiled(e.getItReturnFiled());
        dto.setProductType(e.getProductType());
        dto.setStatus(e.getStatus());
        dto.setAppliedAt(e.getAppliedAt());
        dto.setReviewedAt(e.getReviewedAt());
        dto.setRejectionReason(e.getRejectionReason());
        dto.setIssuedCardNumber(e.getIssuedCardNumber());
        return dto;
    }

    private CreditCardResponseDTO toCardDTO(CreditCardEntity e) {
        CreditCardResponseDTO dto = new CreditCardResponseDTO();
        dto.setCardNumber(e.getCardNumber());
        dto.setCardType(e.getCardType());
        dto.setNameOnCard(e.getNameOnCard());
        dto.setExpiryDate(e.getExpiryDate());
        dto.setCvv(e.getCvv());
        dto.setCreditLimit(e.getCreditLimit());
        dto.setAvailableLimit(e.getAvailableLimit());
        dto.setPerDayLimit(e.getPerDayLimit());
        dto.setCardStatus(e.getCardStatus());
        return dto;
    }
}