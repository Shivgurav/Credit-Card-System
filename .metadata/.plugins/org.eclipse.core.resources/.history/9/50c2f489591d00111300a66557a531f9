package com.payPanda.repository;

import com.payPanda.entity.CardApplicationEntity;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface CardApplicationRepository extends JpaRepository<CardApplicationEntity, Long> {

    // Admin dashboard — all pending applications
    List<CardApplicationEntity> findByStatus(String status);

    // Prevent duplicate applications from same PAN
    boolean existsByPanNumber(String panNumber);

    // Get all applications for a PAN (applicant history)
    List<CardApplicationEntity> findByPanNumber(String panNumber);
}