package com.payPanda.config;

import org.springframework.cloud.client.loadbalancer.LoadBalanced;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.web.SecurityFilterChain;
import org.springframework.web.client.RestTemplate;

@Configuration
public class AppConfig {

    // Plain RestTemplate — Docker resolves container names on credit-network
    // No @LoadBalanced needed (that's only for Eureka)
    @Bean
    @LoadBalanced
    public RestTemplate restTemplate() {
        return new RestTemplate();
    }
    @Bean
    public SecurityFilterChain filterChain(HttpSecurity http) throws Exception {
        http
            .authorizeHttpRequests(authz -> authz
                .anyRequest().permitAll()   // allow all requests without authentication
            )
            .csrf(csrf -> csrf.disable())   // disable CSRF (optional, but often needed for APIs)
            .formLogin(form -> form.disable())  // disable the default login page
            .httpBasic(httpBasic -> httpBasic.disable()); // disable HTTP basic auth if desired

        return http.build();
   }
  
}