package com.payPanda.dto;

import jakarta.validation.constraints.DecimalMin;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;
import lombok.Data;

import java.math.BigDecimal;

@Data
public class TransactionRequestDTO {

    @NotNull(message = "Card number is mandatory")
    private Long cardNumber;        // 16-digit card number as Long

    @NotBlank(message = "Merchant ID is mandatory")
    private String merchantId;      // 7-digit merchant code

    @NotNull(message = "Amount is mandatory")
    @DecimalMin(value = "0.01", message = "Amount must be greater than zero")
    private BigDecimal amount;
}