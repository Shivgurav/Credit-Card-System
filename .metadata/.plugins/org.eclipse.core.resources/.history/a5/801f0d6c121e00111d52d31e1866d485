package com.payPanda.service;

import com.payPanda.dto.*;
import com.payPanda.entity.CardApplicationEntity;
import com.payPanda.entity.CreditCardEntity;
import com.payPanda.exception.*;
import com.payPanda.repository.CardApplicationRepository;
import com.payPanda.repository.CreditCardRepository;

import lombok.RequiredArgsConstructor;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.security.SecureRandom;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.List;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
public class CardServiceImpl implements CardService {

    private static final Logger log = LoggerFactory.getLogger(CardServiceImpl.class);
    private static final SecureRandom random = new SecureRandom();

    private final CardApplicationRepository applicationRepo;
    private final CreditCardRepository cardRepo;
    private final PasswordEncoder passwordEncoder;   // ✅ for PIN hashing
    private final EmailService emailService;         // ✅ for PIN OTP

    // ── Submit Application ────────────────────────────────────────
    @Override
    public CardApplicationResponseDTO submitApplication(CardApplicationRequestDTO request) {
        if (applicationRepo.existsByPanNumber(request.getPanNumber()))
            throw new DuplicateApplicationException("Application with PAN " + request.getPanNumber() + " already exists");
        if (applicationRepo.existsByEmail(request.getEmail()))
            throw new DuplicateApplicationException("Application with email " + request.getEmail() + " already exists");

        CardApplicationEntity application = new CardApplicationEntity();
        application.setName(request.getName());
        application.setDateOfBirth(request.getDateOfBirth());
        application.setPanNumber(request.getPanNumber().toUpperCase());
        application.setEmail(request.getEmail());
        application.setMobileNumber(request.getMobileNumber());
        application.setAddress(request.getAddress());
        application.setOccupation(request.getOccupation());
        application.setAnnualSalary(request.getAnnualSalary());
        application.setItReturnFiled(request.getItReturnFiled());
        application.setCardType(request.getCardType().toUpperCase());
        application.setApplicationStatus("PENDING");
        application.setAppliedAt(LocalDateTime.now());

        CardApplicationEntity saved = applicationRepo.save(application);
        return toApplicationDTO(saved);
    }

    // ── Get Applications ──────────────────────────────────────────
    @Override
    public List<CardApplicationResponseDTO> getPendingApplications() {
        return applicationRepo.findByApplicationStatus("PENDING")
                .stream().map(this::toApplicationDTO).collect(Collectors.toList());
    }

    @Override
    public List<CardApplicationResponseDTO> getAllApplications() {
        return applicationRepo.findAll()
                .stream().map(this::toApplicationDTO).collect(Collectors.toList());
    }

    // ── Review Application ────────────────────────────────────────
    @Override
    @Transactional
    public CardApplicationResponseDTO reviewApplication(Long applicationId, AdminReviewRequestDTO review) {
        CardApplicationEntity application = applicationRepo.findById(applicationId)
                .orElseThrow(() -> new ApplicationNotFoundException("Application not found: " + applicationId));

        if (!"PENDING".equals(application.getApplicationStatus()))
            throw new IllegalStateException("Application " + applicationId + " already " + application.getApplicationStatus());

        application.setReviewedAt(LocalDateTime.now());

        if ("APPROVED".equals(review.getDecision())) {
            application.setApplicationStatus("APPROVED");
            CreditCardEntity card = generateCard(application);
            cardRepo.save(card);
            application.setCardNumber(card.getCardNumber());
        } else {
            if (review.getRejectionReason() == null || review.getRejectionReason().isBlank())
                throw new IllegalStateException("Rejection reason is required");
            application.setApplicationStatus("REJECTED");
            application.setRejectionReason(review.getRejectionReason());
        }

        return toApplicationDTO(applicationRepo.save(application));
    }

    // ── Get Card ──────────────────────────────────────────────────
    @Override
    public CardDetailsDTO getCardByNumber(Long cardNumber) {
        CreditCardEntity card = cardRepo.findById(cardNumber)
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + cardNumber));
        return toCardDTO(card);
    }

    // ── Update Card Status ────────────────────────────────────────
    @Override
    public CardDetailsDTO updateCardStatus(CardStatusUpdateDTO request) {
        CreditCardEntity card = cardRepo.findById(request.getCardNumber())
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + request.getCardNumber()));
        card.setCardStatus(request.getStatus());
        cardRepo.save(card);
        return toCardDTO(card);
    }

    // ── Deduct Available Limit (called by transaction-service) ────
    @Override
    @Transactional
    public void deductAvailableLimit(Long cardNumber, BigDecimal amount) {
        CreditCardEntity card = cardRepo.findById(cardNumber)
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + cardNumber));

        BigDecimal newLimit = card.getAvailableLimit().subtract(amount);
        if (newLimit.compareTo(BigDecimal.ZERO) < 0)
            throw new IllegalStateException("Deduction would result in negative available limit");

        card.setAvailableLimit(newLimit);
        // ✅ Increase outstanding bill
        BigDecimal currentBill = card.getOutstandingBill() != null ? card.getOutstandingBill() : BigDecimal.ZERO;
        card.setOutstandingBill(currentBill.add(amount));
        cardRepo.save(card);
    }

    // ── Pay Bill ──────────────────────────────────────────────────
    @Override
    @Transactional
    public CardDetailsDTO payBill(Long cardNumber, BigDecimal amount) {
        CreditCardEntity card = cardRepo.findById(cardNumber)
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + cardNumber));

        BigDecimal outstanding = card.getOutstandingBill() != null
                ? card.getOutstandingBill() : BigDecimal.ZERO;

        if (amount.compareTo(BigDecimal.ZERO) <= 0)
            throw new IllegalStateException("Payment amount must be greater than zero");
        if (amount.compareTo(outstanding) > 0)
            throw new IllegalStateException("Payment ₹" + amount + " exceeds outstanding bill ₹" + outstanding);

        card.setAvailableLimit(card.getAvailableLimit().add(amount));
        card.setOutstandingBill(outstanding.subtract(amount));
        cardRepo.save(card);

        log.info("Bill paid: card={} amount={} newAvailableLimit={} remainingBill={}",
                cardNumber, amount, card.getAvailableLimit(), card.getOutstandingBill());
        return toCardDTO(card);
    }

    // ── Request PIN OTP ───────────────────────────────────────────
    @Override
    public String requestPinOtp(Long cardNumber) {
        CreditCardEntity card = cardRepo.findById(cardNumber)
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + cardNumber));

        // ✅ Get email from application
        CardApplicationEntity application = applicationRepo.findById(card.getApplicationId())
                .orElseThrow(() -> new ApplicationNotFoundException("Application not found"));

        String otp = String.valueOf(100000 + random.nextInt(900000));

        card.setPin(otp);  // ✅ store plain OTP temporarily for verification
        cardRepo.save(card);
        log.info("Sending OTP {} to email {}", otp, application.getEmail());

        try {
            emailService.sendEmail(
                application.getEmail(),
                "PayPanda - Card PIN Generation OTP",
                "Dear " + card.getCustomerName() + ",\n\n"
                + "Your OTP to generate card PIN is: " + otp + "\n\n"
                + "Valid for 5 minutes. Do not share this OTP.\n\n"
                + "PayPanda Team"
            );
        } catch (Exception e) {
            log.warn("PIN OTP email failed for card={}: {}", cardNumber, e.getMessage());
            // ✅ Don't throw — OTP is saved in DB, user can still proceed
        }

        return "OTP sent to registered email";
    }

    // ── Set PIN ───────────────────────────────────────────────────
    @Override
    @Transactional
    public String setPin(Long cardNumber, String otp, String newPin) {
        CreditCardEntity card = cardRepo.findById(cardNumber)
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + cardNumber));

        // Verify OTP stored temporarily
        if (card.getPin() == null || !card.getPin().equals(otp))
            return "Invalid OTP";

        if (newPin == null || !newPin.matches("^[0-9]{4}$"))
            return "PIN must be exactly 4 digits";

        // Hash and store PIN
        card.setPin(passwordEncoder.encode(newPin));
       cardRepo.saveAndFlush(card);

        log.info("PIN set successfully for card={}", cardNumber);
        return "PIN set successfully";
    }

    // ── Card Generation ───────────────────────────────────────────
    private CreditCardEntity generateCard(CardApplicationEntity application) {
        CreditCardEntity card = new CreditCardEntity();
        card.setCardNumber(generateCardNumber(application.getCardType()));
        card.setApplicationId(application.getApplicationId());
        card.setCustomerName(application.getName());
        card.setPanNumber(application.getPanNumber());
        card.setCardType(application.getCardType());

        BigDecimal creditLimit = calculateCreditLimit(application.getAnnualSalary());
        card.setCreditLimit(creditLimit);
        card.setAvailableLimit(creditLimit);
        card.setPerDayLimit(creditLimit.multiply(BigDecimal.valueOf(0.20)));
        card.setCashWithdrawalLimit(creditLimit.multiply(BigDecimal.valueOf(0.30))); // ✅ 30% of limit
        card.setOutstandingBill(BigDecimal.ZERO);                                    // ✅ starts at 0
        card.setPin(null);                                                           // ✅ PIN not set yet
        card.setExpiryDate(calculateExpiry(3));
        card.setCvv(generateCvv());
        card.setCardStatus("Open");
        return card;
    }

    private Long generateCardNumber(String cardType) {
        for (int i = 0; i < 10; i++) {
            String prefix = "VISA".equals(cardType) ? "4" : "5";
            long suffix = (long)(Math.random() * 1_000_000_000_000_000L) % 1_000_000_000_000_000L;
            String numberStr = prefix + String.format("%015d", Math.abs(suffix));
            Long cardNumber = Long.parseLong(numberStr);
            if (!cardRepo.existsById(cardNumber)) return cardNumber;
        }
        throw new RuntimeException("Could not generate unique card number");
    }

    private BigDecimal calculateCreditLimit(BigDecimal annualSalary) {
        double salary = annualSalary.doubleValue();
        if (salary < 300_000)        return BigDecimal.valueOf(25_000);
        else if (salary < 600_000)   return BigDecimal.valueOf(50_000);
        else if (salary < 1_000_000) return BigDecimal.valueOf(100_000);
        else if (salary < 2_000_000) return BigDecimal.valueOf(200_000);
        else                         return BigDecimal.valueOf(500_000);
    }

    private String calculateExpiry(int yearsValid) {
        LocalDate expiry = LocalDate.now().plusYears(yearsValid);
        return String.format("%02d%02d", expiry.getYear() % 100, expiry.getMonthValue());
    }

    private String generateCvv() {
        return String.valueOf(100 + random.nextInt(900));
    }

    // ── Mappers ───────────────────────────────────────────────────
    private CardApplicationResponseDTO toApplicationDTO(CardApplicationEntity e) {
        CardApplicationResponseDTO dto = new CardApplicationResponseDTO();
        dto.setApplicationId(e.getApplicationId());
        dto.setName(e.getName());
        dto.setPanNumber(e.getPanNumber());
        dto.setEmail(e.getEmail());
        dto.setMobileNumber(e.getMobileNumber());
        dto.setOccupation(e.getOccupation());
        dto.setAnnualSalary(e.getAnnualSalary());
        dto.setItReturnFiled(e.getItReturnFiled());
        dto.setCardType(e.getCardType());
        dto.setApplicationStatus(e.getApplicationStatus());
        dto.setAppliedAt(e.getAppliedAt());
        dto.setReviewedAt(e.getReviewedAt());
        dto.setRejectionReason(e.getRejectionReason());
        dto.setCardNumber(e.getCardNumber());
        return dto;
    }

    private CardDetailsDTO toCardDTO(CreditCardEntity e) {
        CardDetailsDTO dto = new CardDetailsDTO();
        dto.setCardNumber(e.getCardNumber());
        dto.setCustomerName(e.getCustomerName());
        dto.setCardType(e.getCardType());
        dto.setCreditLimit(e.getCreditLimit());
        dto.setAvailableLimit(e.getAvailableLimit());
        dto.setExpiryDate(e.getExpiryDate());
        dto.setCardStatus(e.getCardStatus());
        dto.setPerDayLimit(e.getPerDayLimit());
        dto.setCashWithdrawalLimit(e.getCashWithdrawalLimit());   // ✅
        dto.setOutstandingBill(e.getOutstandingBill());           // ✅
        dto.setPinSet(e.getPin() != null);                        // ✅ never expose actual PIN
        return dto;
    }
    @Override
    public String verifyPin(Long cardNumber, String pin) {
        CreditCardEntity card = cardRepo.findById(cardNumber)
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + cardNumber));

        if (card.getPin() == null)
            return "PIN not set. Please generate your PIN first.";

        if (passwordEncoder.matches(pin, card.getPin()))
            return "PIN verified";
        else
            return "Invalid PIN";
    }
    @Override
    @Transactional
    public CardDetailsDTO cashWithdrawal(Long cardNumber, BigDecimal amount) {
        CreditCardEntity card = cardRepo.findById(cardNumber)
                .orElseThrow(() -> new CardNotFoundException("Card not found: " + cardNumber));

        if (!"Open".equals(card.getCardStatus()))
            throw new IllegalStateException("Card is " + card.getCardStatus() + ". Cannot withdraw cash.");

        if (card.getCashWithdrawalLimit() == null ||
            amount.compareTo(card.getCashWithdrawalLimit()) > 0)
            throw new IllegalStateException("Amount exceeds cash withdrawal limit of ₹"
                + card.getCashWithdrawalLimit());

        if (amount.compareTo(card.getAvailableLimit()) > 0)
            throw new IllegalStateException("Insufficient available limit.");

        BigDecimal newAvailable = card.getAvailableLimit().subtract(amount);
        BigDecimal newOutstanding = (card.getOutstandingBill() != null
                ? card.getOutstandingBill() : BigDecimal.ZERO).add(amount);

        card.setAvailableLimit(newAvailable);
        card.setOutstandingBill(newOutstanding);
        cardRepo.save(card);

        log.info("Cash withdrawal: card={} amount={} newAvailableLimit={}", 
                cardNumber, amount, newAvailable);
        return toCardDTO(card);
    }
}