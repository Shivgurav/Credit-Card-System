package com.payPanda.controller;

import com.payPanda.dto.*;
import com.payPanda.service.CardService;

import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.math.BigDecimal;
import java.util.List;

@RestController
@RequestMapping("/cards")
@RequiredArgsConstructor
public class CardController {

    private final CardService cardService;

    // ── Application flow ──────────────────────────────────────────────────

    /**
     * POST /cards/apply
     * Customer submits a card application from React form.
     * Saves as PENDING and returns the application for confirmation screen.
     */
    @PostMapping("/apply")
    public ResponseEntity<CardApplicationResponseDTO> applyForCard(
            @Valid @RequestBody CardApplicationRequestDTO request) {
        return ResponseEntity.status(HttpStatus.CREATED)
                .body(cardService.submitApplication(request));
    }

    /**
     * GET /cards/applications/pending
     * Admin dashboard — lists all applications waiting for review.
     */
    @GetMapping("/applications/pending")
    public ResponseEntity<List<CardApplicationResponseDTO>> getPendingApplications() {
        return ResponseEntity.ok(cardService.getPendingApplications());
    }

    /**
     * GET /cards/applications
     * Admin — all applications regardless of status.
     */
    @GetMapping("/applications")
    public ResponseEntity<List<CardApplicationResponseDTO>> getAllApplications() {
        return ResponseEntity.ok(cardService.getAllApplications());
    }

    /**
     * PUT /cards/applications/{applicationId}/review
     * Admin approves or rejects an application.
     * On APPROVED: card is auto-generated and returned immediately.
     */
    @PutMapping("/applications/{applicationId}/review")
    public ResponseEntity<CardApplicationResponseDTO> reviewApplication(
            @PathVariable Long applicationId,
            @Valid @RequestBody AdminReviewRequestDTO review) {
        return ResponseEntity.ok(cardService.reviewApplication(applicationId, review));
    }

    // ── Card operations ───────────────────────────────────────────────────

    /**
     * GET /cards/{cardNumber}
     * Get card details. Used by transaction-service to validate card.
     * CVV is NOT included in response.
     */
    @GetMapping("/{cardNumber}")
    public ResponseEntity<CardDetailsDTO> getCard(@PathVariable Long cardNumber) {
        return ResponseEntity.ok(cardService.getCardByNumber(cardNumber));
    }

    /**
     * PUT /cards/status
     * Admin blocks or closes a card (doc section 4.4).
     */
    @PutMapping("/status")
    public ResponseEntity<CardDetailsDTO> updateCardStatus(
            @Valid @RequestBody CardStatusUpdateDTO request) {
        return ResponseEntity.ok(cardService.updateCardStatus(request));
    }

    /**
     * PUT /cards/{cardNumber}/deduct-limit
     * Called ONLY by transaction-service after an APPROVED transaction.
     * Subtracts transaction amount from available_limit.
     */
    @PutMapping("/{cardNumber}/deduct-limit")
    public ResponseEntity<Void> deductLimit(
            @PathVariable Long cardNumber,
            @RequestBody UpdateLimitRequestDTO request) {
        cardService.deductAvailableLimit(cardNumber, request.getAmount());
        return ResponseEntity.ok().build();
    }
}